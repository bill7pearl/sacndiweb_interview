{
    "name": "scandiweb/ecommerce",
    "description": "Scandiweb eCommerce Project",
    "type": "project",
    "require": {
        "php": "^7.4|^8.1",
        "webonyx/graphql-php": "^14.11",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "Scandiweb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scandiweb\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
} 